{
  "name": "pulsefit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/unit.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:mongo": "tsx scripts/mongo-setup.ts",
    "db:embed": "tsx scripts/embed.ts",
    "test:api": "tsx --test tests/api.test.ts",
    "verify": "tsx scripts/verify.ts",
    "services": "tsx scripts/local-services.ts",
    "test:server": "tsx scripts/test-server.ts",
    "test:smoke": "tsx --test tests/smoke.test.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "jose": "^6.1.0",
    "mongodb": "^6.20.0",
    "next": "16.4.3",
    "pg": "^8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
