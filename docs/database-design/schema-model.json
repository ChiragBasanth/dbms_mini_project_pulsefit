    {
      "name": "trainer_availability",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "nullable": false,
          "default": "gen_random_uuid()",
          "key": [
            "PK"
          ]
        },
        {
          "name": "trainer_id",
          "type": "uuid",
          "nullable": false,
          "default": null,
