DATABASE_URL=postgresql://pulsefit:replace_me@localhost:5432/pulsefit
# Native setup: fill both runtime URLs for administrator-precreated restricted roles.
# Empty runtime URLs ask db:rbac to create roles and require CREATEROLE; see SETUP.md.
APP_DATABASE_URL=
TEST_APP_DATABASE_URL=
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=pulsefit
SESSION_SECRET=replace_with_at_least_32_random_characters
APP_ORIGIN=http://localhost:3000
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_CACHE=./.cache/models
# Demo-only password used by db:seed; required, never included in code.
SEED_PASSWORD=
# Integration tests refuse non-test database names. Use disposable databases only.
TEST_DATABASE_URL=postgresql://pulsefit:replace_me@localhost:5432/pulsefit_test
TEST_MONGODB_URI=mongodb://127.0.0.1:27017
TEST_MONGODB_DB=pulsefit_test
